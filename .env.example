# ==============================================================================
# AUDIOBOOK AUTOMATION CONFIGURATION
# Copy file này thành .env và điền các khóa API của bạn
# ==============================================================================

# Gemini AI API Key (Lấy miễn phí tại: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Pexels API Key(s) (Lấy tại: https://www.pexels.com/api/)
# Bạn có thể nhập nhiều key cách nhau bằng dấu phẩy để hệ thống tự động xoay tua
PEXELS_API_KEYS=your_pexels_key_1,your_pexels_key_2

# Cấu hình thiết bị: cuda (GPU NVIDIA) hoặc cpu
DEVICE=cuda

# VieNeu-TTS settings
VIENEU_FUSED_FRAME=0

# Cấu hình YouTube OAuth2 (Tùy chọn)
# Đặt file client_secret.json tải từ Google Cloud Console vào thư mục gốc hoặc chỉ định tại đây:
YOUTUBE_CLIENT_SECRET=client_secret.json
YOUTUBE_TOKEN=token.json

# Thư mục lưu trữ
OUTPUTS_DIR=outputs
TEMP_DIR=temp_work
